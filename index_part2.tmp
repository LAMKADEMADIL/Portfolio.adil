    <!-- ===== CUSTOM CONFIRM MODAL ===== -->
    <div id="custom-confirm-modal" class="custom-confirm-overlay">
      <div class="custom-confirm-card glass-card">
        <div class="confirm-icon-area">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="confirm-main-icon"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </div>
        <h3 id="confirm-title">Redirection</h3>
        <p id="confirm-message">Voulez-vous ouvrir ce lien ?</p>
        <div class="confirm-actions">
          <button id="confirm-cancel-btn" class="btn btn-secondary">Annuler</button>
          <button id="confirm-ok-btn" class="btn btn-primary">Continuer</button>
        </div>
      </div>
    </div>

